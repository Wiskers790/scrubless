{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scrubless",
  "version": "0.1.1",
  "identifier": "app.scrubless",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Scrubless",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "engines/**/*"
    ],
    "category": "Video",
    "shortDescription": "Search your footage, photos and sounds by describing them. Offline.",
    "longDescription": "Scrubless indexes your video, photo and audio folders on your own computer and lets you find any shot, quote or sound by describing it in any language, then send the moments to your editor.",
    "linux": {
      "deb": {
        "depends": [
          "libvulkan1"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}